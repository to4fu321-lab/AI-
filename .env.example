# Supabase プロジェクト設定（Vercel の Environment Variables に設定する）
# 値は Supabase ダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role キー。絶対にブラウザに漏らさないこと（NEXT_PUBLIC_ を付けない）
SUPABASE_SERVICE_ROLE_KEY=

# POST /api/videos への書き込みを許可するための共有シークレット
# OpenClaw / Make 側にも同じ値を設定して x-api-key ヘッダーに載せる
INGEST_API_KEY=

# --- 動画オート投稿（/autopost）・会員制動画サイト（/members） ---
# 投稿先のログイン情報を暗号化する鍵（16 文字以上のでたらめな文字）。
# 変えると保存済みの鍵が読めなくなり、会員も全員ログインし直しになる。作り方の例：openssl rand -base64 32
AUTOPOST_SECRET=
# 題名と本文を AI（Claude）で作るための鍵。なくても動くが、文はメモの写しになる
ANTHROPIC_API_KEY=
