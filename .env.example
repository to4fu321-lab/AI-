# Supabase プロジェクト設定（Vercel の Environment Variables に設定する）
# 値は Supabase ダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role キー。絶対にブラウザに漏らさないこと（NEXT_PUBLIC_ を付けない）
SUPABASE_SERVICE_ROLE_KEY=

# POST /api/videos への書き込みを許可するための共有シークレット
# OpenClaw / Make 側にも同じ値を設定して x-api-key ヘッダーに載せる
INGEST_API_KEY=
